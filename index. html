                <div class="my-city-country" id="myCityCountry">—</div>
                <div class="my-city-time">
                    <span id="myCityHHMM">--:--</span><span class="my-city-seconds" id="myCitySS">:--</span>
                </div>
                <div class="my-city-date" id="myCityDate">—</div>
                <div class="my-city-tz" id="myCityTz">—</div>

                <!-- Кнопка "+" -->
                <div class="add-city-wrap">
                    <button class="add-city-btn" id="addCityBtn" title="Добавить город">+</button>
                </div>

                <!-- Дополнительные города -->
                <div class="extra-cities" id="extraCities"></div>

                <button class="change-city-btn" id="changeCityBtn">Сменить мой город</button>
            </div>
        </div>

        <!-- Вкладка 2: Все города -->
        <div class="tab-content" id="tab-all">
            <input type="text" id="search" class="search-box" placeholder="Поиск города или страны..." autocomplete="off">
            <div class="stats" id="stats"></div>
            <div class="city-grid" id="grid"></div>
            <div class="no-results" id="noResults" style="display:none;">Город не найден</div>
        </div>
    </div>

