            ["Таллин", "Эстония", "Europe/Tallinn"],
            ["Хартум", "Судан", "Africa/Khartoum"],
            ["Триполи", "Ливия", "Africa/Tripoli"],
            ["Рабат", "Марокко", "Africa/Casablanca"],
            ["Абуджа", "Нигерия", "Africa/Lagos"],
            ["Луанда", "Ангола", "Africa/Luanda"],
            ["Дар-эс-Салам", "Танзания", "Africa/Dar_es_Salaam"],
            ["Кампала", "Уганда", "Africa/Kampala"],
            ["Кигали", "Руанда", "Africa/Kigali"],
            ["Хараре", "Зимбабве", "Africa/Harare"],
            ["Лусака", "Замбия", "Africa/Lusaka"],
            ["Габороне", "Ботсвана", "Africa/Gaborone"],
            ["Виндхук", "Намибия", "Africa/Windhoek"],
            ["Мапуту", "Мозамбик", "Africa/Maputo"],
            ["Антананариву", "Мадагаскар", "Indian/Antananarivo"],
            ["Порт-Луи", "Маврикий", "Indian/Mauritius"],
            ["Виктория", "Сейшелы", "Indian/Mahe"],
            ["Мале", "Мальдивы", "Indian/Maldives"],
            ["Кабул", "Афганистан", "Asia/Kabul"],
            ["Ашхабад", "Туркменистан", "Asia/Ashgabat"],
        ];

        const uniqueCities = [];
        const seen = new Set();
        for (const c of CITIES) {
            const key = c[0] + '|' + c[1] + '|' + c[2];
            if (!seen.has(key)) {
                seen.add(key);
                uniqueCities.push(c);
            }
        }
        uniqueCities.sort((a, b) => a[0].localeCompare(b[0], 'ru'));

        // ===== Элементы =====
        const modalOverlay = document.getElementById('modalOverlay');
        const modalTitle = document.getElementById('modalTitle');
        const modalSubtitle = document.getElementById('modalSubtitle');
        const modalInput = document.getElementById('modalInput');
        const modalSuggestions = document.getElementById('modalSuggestions');
        const modalError = document.getElementById('modalError');
        const modalConfirm = document.getElementById('modalConfirm');

        const grid = document.getElementById('grid');
        const searchInput = document.getElementById('search');
        const noResults = document.getElementById('noResults');
        const statsEl = document.getElementById('stats');

        const myCityName = document.getElementById('myCityName');
        const myCityCountry = document.getElementById('myCityCountry');
        const myCityHHMM = document.getElementById('myCityHHMM');
        const myCitySS = document.getElementById('myCitySS');
        const myCityDate = document.getElementById('myCityDate');
        const myCityTz = document.getElementById('myCityTz');
        const changeCityBtn = document.getElementById('changeCityBtn');
        const addCityBtn = document.getElementById('addCityBtn');
        const extraCitiesEl = document.getElementById('extraCities');

        // ===== Состояние =====
        const STORAGE_HOME = 'worldclock_home_city';
        const STORAGE_EXTRA = 'worldclock_extra_cities';

        let homeCity = null;
        let extraCities = [];          // [{name, country, tz}, ...]
        let selectedCity = null;       // выбранный в модалке
        let modalMode = 'home';        // 'home' | 'add'
        let timeElements = [];         // карточки на вкладке "Все города"
        let extraElements = [];        // элементы дополнительных городов

        // ===== Вкладки =====
        document.querySelectorAll('.tab').forEach(tab => {
            tab.addEventListener('click', () => {
                document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
                document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
                tab.classList.add('active');
                document.getElementById('tab-' + tab.dataset.tab).classList.add('active');
            });
        });

        // ===== Модальное окно =====
        function openModal(mode) {
            modalMode = mode || 'home';
            if (modalMode === 'home') {
                modalTitle.textContent = 'В каком городе вы живёте?';
                modalSubtitle.textContent = 'Выберите город — его время будет на первой вкладке.';
            } else {
                modalTitle.textContent = 'Добавить город';
                modalSubtitle.textContent = 'Выберите город — его время добавится под вашим.';
            }
            modalOverlay.classList.remove('hidden');
            modalInput.value = '';
            modalSuggestions.innerHTML = '';
            modalError.textContent = '';
            selectedCity = null;
            modalConfirm.disabled = true;
            renderSuggestions('');
            setTimeout(() => modalInput.focus(), 50);
        }

        function closeModal() {
            modalOverlay.classList.add('hidden');
        }

        function renderSuggestions(query) {
            const q = query.toLowerCase().trim();
            modalSuggestions.innerHTML = '';
            const list = q
                ? uniqueCities.filter(c => (c[0] + ' ' + c[1]).toLowerCase().includes(q))
                : uniqueCities;

            const shown = list.slice(0, 30);
            if (shown.length === 0) {
                modalError.textContent = 'Город не найден';
                return;
            }

            for (const [name, country, tz] of shown) {
                const div = document.createElement('div');
                div.className = 'suggestion';
                div.innerHTML = `<span>${name}</span><span class="s-country">${country}</span>`;
                div.addEventListener('click', () => {
                    selectedCity = { name, country, tz };
                    modalSuggestions.querySelectorAll('.suggestion').forEach(s => s.classList.remove('active'));
                    div.classList.add('active');
                    modalConfirm.disabled = false;
                    modalError.textContent = '';
                    modalInput.value = name;
                });
                modalSuggestions.appendChild(div);
            }
        }

        let modalTimeout;
        modalInput.addEventListener('input', () => {
            clearTimeout(modalTimeout);
            modalTimeout = setTimeout(() => {
                selectedCity = null;
                modalConfirm.disabled = true;
                modalError.textContent = '';
                renderSuggestions(modalInput.value);
            }, 120);
        });

        modalInput.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
                if (selectedCity) {
                    confirmCity();
                } else {
                    const first = modalSuggestions.querySelector('.suggestion');
                    if (first) first.click();
                }
            }
        });

        modalConfirm.addEventListener('click', confirmCity);

        function confirmCity() {
            if (!selectedCity) return;

            if (modalMode === 'home') {
                homeCity = selectedCity;
                localStorage.setItem(STORAGE_HOME, JSON.stringify(homeCity));
                renderMyCity();
                switchToMyTab();
            } else {
                // не добавляем дубликат и не добавляем сам "мой город"
                const isHome = homeCity &&
                    homeCity.name === selectedCity.name &&
                    homeCity.tz === selectedCity.tz;
                const isDup = extraCities.some(c =>
                    c.name === selectedCity.name && c.tz === selectedCity.tz);

                if (!isHome && !isDup) {
                    extraCities.push(selectedCity);
                    saveExtraCities();
                    renderExtraCities();
                    updateExtraTimes();
                }
            }
            closeModal();
        }

        function saveExtraCities() {
            localStorage.setItem(STORAGE_EXTRA, JSON.stringify(extraCities));
        }

        function switchToMyTab() {
            document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
            document.querySelector('.tab[data-tab="my"]').classList.add('active');
            document.getElementById('tab-my').classList.add('active');
        }

        changeCityBtn.addEventListener('click', () => openModal('home'));
        addCityBtn.addEventListener('click', () => openModal('add'));

        // ===== Отображение "Мой город" =====
        function renderMyCity() {
            if (!homeCity) {
                myCityName.textContent = 'Город не выбран';
                myCityCountry.textContent = '';
                myCityHHMM.textContent = '--:--';
                myCitySS.textContent = ':--';
                myCityDate.textContent = '—';
                myCityTz.textContent = '—';
                return;
            }
            myCityName.textContent = homeCity.name;
            myCityCountry.textContent = homeCity.country;
            myCityTz.textContent = homeCity.tz;
        }

        function updateMyCityTime() {
            if (!homeCity) return;
            const now = new Date();
            try {
                const timeStr = now.toLocaleTimeString('ru-RU', {
                    timeZone: homeCity.tz,
                    hour12: false,
                    hour: '2-digit',
                    minute: '2-digit',
                    second: '2-digit',
                });
                const parts = timeStr.split(':');
                myCityHHMM.textContent = parts[0] + ':' + parts[1];
                myCitySS.textContent = ':' + parts[2];

                myCityDate.textContent = now.toLocaleDateString('ru-RU', {
                    timeZone: homeCity.tz,
                    weekday: 'long',
                    day: 'numeric',
                    month: 'long',
                    year: 'numeric',
                });
            } catch (e) {
                myCityHHMM.textContent = '--:--';
                myCitySS.textContent = ':--';
            }
        }

        // ===== Дополнительные города =====
        function renderExtraCities() {
            extraCitiesEl.innerHTML = '';
            extraElements = [];

            for (let i = 0; i < extraCities.length; i++) {
                const city = extraCities[i];

                const row = document.createElement('div');
                row.className = 'extra-city';

                const info = document.createElement('div');
                info.className = 'extra-info';

                const nameEl = document.createElement('div');
                nameEl.className = 'extra-name';
                nameEl.textContent = city.name;

                const dateEl = document.createElement('div');
                dateEl.className = 'extra-date';
                dateEl.textContent = '---';

                info.appendChild(nameEl);
                info.appendChild(dateEl);

                const timeWrap = document.createElement('div');
                timeWrap.className = 'extra-time-wrap';

                const timeEl = document.createElement('div');
                timeEl.className = 'extra-time';
                timeEl.textContent = '--:--:--';

                const removeBtn = document.createElement('button');
                removeBtn.className = 'remove-extra';
                removeBtn.textContent = '×';
                removeBtn.title = 'Удалить';
                removeBtn.addEventListener('click', () => {
                    extraCities.splice(i, 1);
                    saveExtraCities();
                    renderExtraCities();
                    updateExtraTimes();
                });

                timeWrap.appendChild(timeEl);
                timeWrap.appendChild(removeBtn);

                row.appendChild(info);
                row.appendChild(timeWrap);
                extraCitiesEl.appendChild(row);

                extraElements.push({ timeEl, dateEl, tz: city.tz });
            }
        }

        function updateExtraTimes() {
            const now = new Date();
            for (const { timeEl, dateEl, tz } of extraElements) {
                try {
                    timeEl.textContent = now.toLocaleTimeString('ru-RU', {
                        timeZone: tz,
                        hour12: false,
                        hour: '2-digit',
                        minute: '2-digit',
                        second: '2-digit',
                    });
                    dateEl.textContent = now.toLocaleDateString('ru-RU', {
                        timeZone: tz,
                        weekday: 'short',
                        day: 'numeric',
                        month: 'short',
                    });
                } catch (e) {
                    timeEl.textContent = 'Ошибка';
                    dateEl.textContent = '';
                }
            }
        }

        // ===== Вкладка "Все города" =====
        function buildGrid(filter) {
            grid.innerHTML = '';
            timeElements = [];
            const f = filter.toLowerCase().trim();
            let visibleCount = 0;

            for (const [name, country, tz] of uniqueCities) {
                const text = (name + ' ' + country + ' ' + tz).toLowerCase();
                if (f && !text.includes(f)) continue;

                visibleCount++;

                const card = document.createElement('div');
                card.className = 'city-card';

                const info = document.createElement('div');
                info.className = 'city-info';

                const nameEl = document.createElement('div');
                nameEl.className = 'city-name';
                nameEl.textContent = name;

                const countryEl = document.createElement('div');
                countryEl.className = 'city-country';
                countryEl.textContent = country;

                info.appendChild(nameEl);
                info.appendChild(countryEl);

                const timeWrapper = document.createElement('div');
                timeWrapper.style.textAlign = 'right';

                const timeEl = document.createElement('div');
                timeEl.className = 'city-time';
                timeEl.textContent = '--:--:--';

                const dateEl = document.createElement('div');
                dateEl.className = 'city-date';
                dateEl.textContent = '---';

                timeWrapper.appendChild(timeEl);
                timeWrapper.appendChild(dateEl);

                card.appendChild(info);
                card.appendChild(timeWrapper);
                grid.appendChild(card);

                timeElements.push({ timeEl, dateEl, tz });
            }

            noResults.style.display = visibleCount === 0 ? 'block' : 'none';
            statsEl.textContent = `Показано: ${visibleCount} из ${uniqueCities.length} городов`;
        }

        function updateAllCitiesTimes() {
            const now = new Date();
            for (const { timeEl, dateEl, tz } of timeElements) {
                try {
                    timeEl.textContent = now.toLocaleTimeString('ru-RU', {
                        timeZone: tz,
                        hour12: false,
                        hour: '2-digit',
                        minute: '2-digit',
                        second: '2-digit',
                    });
                    dateEl.textContent = now.toLocaleDateString('ru-RU', {
                        timeZone: tz,
                        weekday: 'short',
                        day: 'numeric',
                        month: 'short',
                    });
                } catch (e) {
                    timeEl.textContent = 'Ошибка';
                    dateEl.textContent = 'часового пояса';
                }
            }
        }

        let searchTimeout;
        searchInput.addEventListener('input', () => {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => {
                buildGrid(searchInput.value);
                updateAllCitiesTimes();
            }, 200);
        });

        // ===== Общий тик =====
        function tick() {
            updateMyCityTime();
            updateExtraTimes();
            updateAllCitiesTimes();
        }

        // ===== Инициализация =====
        function init() {
            const savedHome = localStorage.getItem(STORAGE_HOME);
            if (savedHome) {
                try { homeCity = JSON.parse(savedHome); } catch (e) { homeCity = null; }
            }

            const savedExtra = localStorage.getItem(STORAGE_EXTRA);
            if (savedExtra) {
                try {
                    extraCities = JSON.parse(savedExtra);
                    if (!Array.isArray(extraCities)) extraCities = [];
                } catch (e) { extraCities = []; }
            }

            buildGrid('');
            renderMyCity();
            renderExtraCities();
            tick();

            if (!homeCity) {
                openModal('home');
            }

            setInterval(tick, 1000);
        }

        init();
    </script>
