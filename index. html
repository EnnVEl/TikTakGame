<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Мировое время</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
            background: #0f172a;
            color: #e2e8f0;
            min-height: 100vh;
            padding: 1.5rem;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        header {
            text-align: center;
            margin-bottom: 1.25rem;
        }

        h1 {
            font-size: 1.8rem;
            font-weight: 600;
            background: linear-gradient(to right, #60a5fa, #a78bfa);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 0.25rem;
        }

        .subtitle {
            font-size: 0.85rem;
            color: #94a3b8;
        }

        /* ---------- Модальное окно ---------- */
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(2, 6, 23, 0.85);
            backdrop-filter: blur(4px);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 100;
            padding: 1rem;
        }

        .modal-overlay.hidden {
            display: none;
        }

        .modal {
            background: #1e293b;
            border: 1px solid #334155;
            border-radius: 16px;
            padding: 1.75rem;
            width: 100%;
            max-width: 420px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
        }

        .modal h2 {
            font-size: 1.15rem;
            font-weight: 600;
            margin-bottom: 0.4rem;
            color: #f1f5f9;
        }

        .modal p {
            font-size: 0.8rem;
            color: #94a3b8;
            margin-bottom: 1rem;
        }

        .modal input {
            width: 100%;
            padding: 0.75rem 1rem;
            border-radius: 10px;
            border: 1px solid #334155;
            background: #0f172a;
            color: #f1f5f9;
            font-size: 1rem;
            outline: none;
            margin-bottom: 0.75rem;
            transition: border-color 0.2s;
        }

        .modal input:focus {
            border-color: #3b82f6;
        }

        .modal-suggestions {
            max-height: 180px;
            overflow-y: auto;
            margin-bottom: 1rem;
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
        }

        .suggestion {
            padding: 0.6rem 0.8rem;
            border-radius: 8px;
            cursor: pointer;
            font-size: 0.9rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: background 0.15s;
        }

        .suggestion:hover,
        .suggestion.active {
            background: #334155;
        }

        .suggestion .s-country {
            font-size: 0.7rem;
            color: #94a3b8;
        }

        .modal-error {
            color: #f87171;
            font-size: 0.8rem;
            margin-bottom: 0.75rem;
            min-height: 1em;
        }

        .btn {
            width: 100%;
            padding: 0.75rem;
            border: none;
            border-radius: 10px;
            background: linear-gradient(to right, #3b82f6, #8b5cf6);
            color: #fff;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: opacity 0.15s;
        }

        .btn:hover {
            opacity: 0.9;
        }

        .btn:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }

        /* ---------- Вкладки ---------- */
        .tabs {
            display: flex;
            gap: 0.5rem;
            justify-content: center;
            margin-bottom: 1.5rem;
            background: #1e293b;
            padding: 0.35rem;
            border-radius: 12px;
            border: 1px solid #334155;
            max-width: 420px;
            margin-left: auto;
            margin-right: auto;
        }

        .tab {
            flex: 1;
            padding: 0.6rem 1rem;
            border: none;
            border-radius: 9px;
            background: transparent;
            color: #94a3b8;
            font-size: 0.9rem;
            font-weight: 500;
            cursor: pointer;
            transition: background 0.15s, color 0.15s;
        }

        .tab.active {
            background: #3b82f6;
            color: #fff;
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
        }

        /* ---------- Вкладка "Мой город" ---------- */
        .my-city-card {
            max-width: 480px;
            margin: 0 auto;
            background: linear-gradient(145deg, #1e293b, #172033);
            border: 1px solid #334155;
            border-radius: 20px;
            padding: 2.5rem 2rem;
            text-align: center;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
        }

        .my-city-name {
            font-size: 1.5rem;
            font-weight: 600;
            color: #f1f5f9;
            margin-bottom: 0.25rem;
        }

        .my-city-country {
            font-size: 0.85rem;
            color: #94a3b8;
            margin-bottom: 1.5rem;
        }

        .my-city-time {
            font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;
            font-size: 3.5rem;
            font-weight: 700;
            color: #60a5fa;
            letter-spacing: 2px;
            line-height: 1.1;
        }

        .my-city-seconds {
            font-size: 1.8rem;
            color: #475569;
        }

        .my-city-date {
            font-size: 1rem;
            color: #cbd5e1;
            margin-top: 1rem;
        }

        .my-city-tz {
            font-size: 0.75rem;
            color: #64748b;
            margin-top: 1.5rem;
            font-family: monospace;
        }

        /* Кнопка "+" под временем */
        .add-city-wrap {
            margin-top: 1.5rem;
        }

        .add-city-btn {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            border: 1px solid #334155;
            background: #0f172a;
            color: #60a5fa;
            font-size: 1.5rem;
            line-height: 1;
            cursor: pointer;
            transition: border-color 0.15s, background 0.15s, transform 0.1s;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .add-city-btn:hover {
            border-color: #3b82f6;
            background: #1e293b;
            transform: scale(1.05);
        }

        /* Дополнительные города */
        .extra-cities {
            margin-top: 1.25rem;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .extra-city {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #0f172a;
            border: 1px solid #334155;
            border-radius: 10px;
            padding: 0.65rem 0.85rem;
            text-align: left;
            transition: border-color 0.15s;
        }

        .extra-city:hover {
            border-color: #475569;
        }

        .extra-info {
            min-width: 0;
            flex: 1;
        }

        .extra-name {
            font-size: 0.85rem;
            font-weight: 500;
            color: #e2e8f0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .extra-date {
            font-size: 0.65rem;
            color: #64748b;
            margin-top: 1px;
        }

        .extra-time-wrap {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            flex-shrink: 0;
            margin-left: 0.5rem;
        }

        .extra-time {
            font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;
            font-size: 1rem;
            font-weight: 600;
            color: #a78bfa;
            letter-spacing: 0.5px;
        }

        .remove-extra {
            width: 22px;
            height: 22px;
            border-radius: 50%;
            border: none;
            background: transparent;
            color: #64748b;
            font-size: 1rem;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: color 0.15s, background 0.15s;
            flex-shrink: 0;
        }

        .remove-extra:hover {
            color: #f87171;
            background: rgba(248, 113, 113, 0.1);
        }

        .change-city-btn {
            margin-top: 1.75rem;
            padding: 0.6rem 1.4rem;
            border: 1px solid #334155;
            border-radius: 9px;
            background: transparent;
            color: #94a3b8;
            font-size: 0.85rem;
            cursor: pointer;
            transition: border-color 0.15s, color 0.15s;
        }

        .change-city-btn:hover {
            border-color: #3b82f6;
            color: #60a5fa;
        }

        /* ---------- Вкладка "Все города" ---------- */
        .search-box {
            width: 100%;
            max-width: 400px;
            margin: 0 auto 1rem;
            display: block;
            padding: 0.7rem 1rem;
            border-radius: 40px;
            border: 1px solid #334155;
            background: #1e293b;
            color: #f1f5f9;
            font-size: 1rem;
            outline: none;
            transition: border-color 0.2s;
        }

        .search-box:focus {
            border-color: #3b82f6;
        }

        .search-box::placeholder {
            color: #64748b;
        }

        .stats {
            text-align: center;
            font-size: 0.8rem;
            color: #64748b;
            margin-bottom: 1rem;
        }

        .city-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 0.75rem;
        }

        .city-card {
            background: #1e293b;
            border-radius: 12px;
            padding: 0.9rem 1rem;
            border: 1px solid #334155;
            transition: border-color 0.15s, background 0.15s;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .city-card:hover {
            border-color: #3b82f6;
            background: #1e2a3f;
        }

        .city-info {
            flex: 1;
            min-width: 0;
        }

        .city-name {
            font-weight: 500;
            font-size: 0.95rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .city-country {
            font-size: 0.7rem;
            color: #94a3b8;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .city-time {
            font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;
            font-size: 1.1rem;
            font-weight: 600;
            color: #60a5fa;
            letter-spacing: 0.5px;
            text-align: right;
            flex-shrink: 0;
            margin-left: 0.75rem;
        }

        .city-date {
            font-size: 0.65rem;
            color: #64748b;
            text-align: right;
            margin-top: 2px;
        }

        .no-results {
            text-align: center;
            color: #64748b;
            padding: 3rem 1rem;
            font-size: 1rem;
        }

        @media (max-width: 500px) {
            body { padding: 1rem; }
            h1 { font-size: 1.4rem; }
            .city-grid { grid-template-columns: 1fr; }
            .city-time { font-size: 1rem; }
            .my-city-time { font-size: 2.8rem; }
            .my-city-card { padding: 2rem 1.25rem; }
        }
    </style>
</head>
