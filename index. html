            <div class="modal-suggestions" id="modalSuggestions"></div>
            <div class="modal-error" id="modalError"></div>
            <button class="btn" id="modalConfirm" disabled>Подтвердить</button>
        </div>
    </div>

    <div class="container">
        <header>
